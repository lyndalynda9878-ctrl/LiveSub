{
  "manifest_version": 3,
  "name": "LiveSub",
  "version": "1.0",
  "description": "Sous-titrage et traduction des vidéos de l’onglet, 100 % local",
  "permissions": [
    "storage",
    "tabCapture",
    "activeTab",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LiveSub"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}