node_modules/

# Regenere par `npm install` (script postinstall -> scripts/copy-assets.js).
# Contient notamment un .wasm de ~13 Mo, inutile de le versionner.
vendor/

# Les poids des modeles. 640 Mo : hors de question de les versionner.
#
# Il n'y en a plus qu'un, NVIDIA Parakeet TDT 0.6B v3 (export ONNX de ysdede),
# telecharge a la main depuis huggingface.co/ysdede/parakeet-tdt-0.6b-v3-onnx :
# encoder-model.int8.onnx, decoder_joint-model.int8.onnx, nemo128.onnx,
# vocab.txt, config.json.
#
# La regle couvre tout le dossier : models/Xenova/ (whisper-tiny, -base, -small)
# a ete supprime a l'etape 5 en meme temps que le mode direct, et
# scripts/fetch-model.js qui le telechargeait n'a plus de raison de tourner.
models/

# Les poids du modele de traduction, telecharges pour les mesures (870 Mo).
# Meme regle que models/ : hors de question de les versionner.
test-nllb-model/
