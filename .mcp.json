{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.7.0",
        "--ignoreDefaultChromeArg=--disable-extensions",
        "--experimentalIncludeAllPages",
        "--categoryExtensions",
        "--viewport=1280x800"
      ]
    }
  }
}
